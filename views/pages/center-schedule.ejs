<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
  <style>
    :root {
      --primary: #4aa3df; --primary-light: #e3f2fd; --sidebar-bg: #333;
      --bg-body: #f4f7f6; --text-main: #333; --border: #edf2f7;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Cairo', sans-serif; background: var(--bg-body); display: flex; min-height: 100vh; color: var(--text-main); }

    .wrapper { flex: 1; display: flex; flex-direction: column; }
    .topbar { height: 60px; background: white; border-bottom: 2px solid var(--border); display: flex; align-items: center; padding: 0 2rem; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
    .main-content { padding: 2rem; }

    .header-section { margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; }
    .header-section h1 { font-size: 1.8rem; font-weight: 800; display: flex; align-items: center; gap: 12px; }

    /* Calendar Grid */
    .calendar-container { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); overflow-x: auto; }
    .calendar-grid { display: grid; grid-template-columns: 100px repeat(7, 1fr); min-width: 1000px; }
    
    .grid-header { background: #fafafa; border-bottom: 2px solid var(--border); padding: 1.25rem 0.5rem; text-align: center; font-weight: 800; font-size: 0.95rem; color: #555; }
    .time-col { background: #fafafa; border-left: 2px solid var(--border); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; color: #777; border-bottom: 1px solid var(--border); }
    
    .day-cell { border-bottom: 1px solid var(--border); border-left: 1px solid var(--border); min-height: 80px; position: relative; padding: 8px; }
    .day-cell:last-child { border-left: none; }
    
    /* Event Card */
    .event-card { background: var(--primary-light); border-right: 4px solid var(--primary); padding: 8px; border-radius: 8px; margin-bottom: 8px; cursor: pointer; transition: 0.2s; position: relative; box-shadow: 0 2px 5px rgba(0,0,0,0.02); }
    .event-card:hover { transform: scale(1.02); box-shadow: 0 5px 15px rgba(74, 163, 223, 0.2); }
    .event-time { font-size: 0.75rem; font-weight: 700; color: var(--primary); margin-bottom: 4px; }
    .event-name { font-size: 0.85rem; font-weight: 800; color: #2c3e50; line-height: 1.3; }
    .event-type { font-size: 0.7rem; color: #7f8c8d; margin-top: 4px; display: flex; align-items: center; gap: 4px; }

    .legend { display: flex; gap: 1.5rem; margin-top: 1.5rem; background: white; padding: 1rem 1.5rem; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); width: fit-content; }
    .legend-item { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; font-weight: 700; }
    .dot { width: 12px; height: 12px; border-radius: 3px; }

    /* Modal Styles */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); display: none; align-items: center; justify-content: center; z-index: 2000; padding: 2rem; backdrop-filter: blur(4px); }
    .modal-card { background: white; width: 100%; max-width: 650px; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.3); animation: slideDown 0.3s ease; }
    @keyframes slideDown { from { transform: translateY(-20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .modal-header { background: linear-gradient(135deg, #4aa3df, #2980b9); color: white; padding: 1.25rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    .modal-header h2 { font-size: 1.1rem; font-weight: 800; display: flex; align-items: center; gap: 8px; }
    .close-btn { background: rgba(255,255,255,0.2); border: none; color: white; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
    .close-btn:hover { background: rgba(255,255,255,0.4); }
    .modal-body { padding: 1.5rem; max-height: 70vh; overflow-y: auto; }
    .modal-footer { padding: 1rem 1.5rem; border-top: 1px solid #eee; display: flex; justify-content: flex-end; gap: 1rem; background: #fafafa; }
    
    .modal-body .form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 1.25rem; }
    .modal-body .form-group label { font-weight: 700; font-size: 0.85rem; color: #555; text-align: right; }
    .modal-body .form-group select, .modal-body .form-group input { padding: 0.65rem; border: 1.5px solid #e0e0e0; border-radius: 8px; font-family: inherit; font-size: 0.95rem; outline: none; transition: 0.2s; text-align: right; }
    .modal-body .form-group select:focus { border-color: var(--primary); }

    .schedule-row { padding: 0.6rem 0; display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 0.75rem; align-items: center; border-bottom: 1px solid #f5f5f5; }
    .schedule-row select, .schedule-row input { padding: 0.5rem; border: 1px solid #ddd; border-radius: 6px; font-family: inherit; width: 100%; }
    .btn-add-row { background: #e8f5e9; color: #388e3c; border: none; padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; font-weight: 700; font-size: 0.85rem; margin-top: 0.75rem; display: inline-flex; align-items: center; gap: 6px; transition: 0.2s; }
    .btn-add-row:hover { background: #388e3c; color: white; }
    .btn-remove-row { background: none; border: none; color: #ccc; cursor: pointer; font-size: 1.1rem; }
    .btn-remove-row:hover { color: #d9534f; }

    .btn-cancel { background: #f0f0f0; color: #555; border: none; padding: 0.65rem 1.25rem; border-radius: 8px; cursor: pointer; font-family: inherit; font-weight: 700; transition: 0.2s; }
    .btn-cancel:hover { background: #e5e5e5; }
    .btn-save { background: var(--primary); color: white; border: none; padding: 0.65rem 1.25rem; border-radius: 8px; cursor: pointer; font-family: inherit; font-weight: 700; transition: 0.2s; }
    .btn-save:hover { background: #3a93cf; }
  </style>
</head>
<body>

  <%- include('../partials/center-sidebar', { active: 'schedule' }) %>

  <div class="wrapper">
    <header class="topbar">
      <div style="font-weight: 800;"><i class='bx bx-calendar' style="color:var(--primary);"></i> الجدول الدراسي الأسبوعي</div>
      <div style="font-size: 0.9rem; color: #777;"><%= user.firstName %> | لوحة تحكم السنتر</div>
    </header>

    <main class="main-content">
      <div class="header-section">
        <div>
          <h1>تخطيط المواعيد</h1>
          <p style="color: #777;">عارض زمني لكافة مجموعات السنتر خلال أيام الأسبوع</p>
        </div>
        <div style="display: flex; gap: 10px;">
          <button class="btn-primary" style="background:var(--primary); color:white; border:none; padding: 0.8rem 1.5rem; border-radius: 10px; font-family: inherit; font-weight: 800; cursor: pointer; display: flex; align-items: center; gap: 8px;" onclick="openScheduleModal()">
            <i class='bx bx-calendar-plus'></i> إضافة/تعديل المواعيد
          </button>
          <button class="btn-primary" style="background:#6c757d; color:white; border:none; padding: 0.8rem 1.5rem; border-radius: 10px; font-family: inherit; font-weight: 800; cursor: pointer; display: flex; align-items: center; gap: 8px;" onclick="location.href='/center/groups'">
            <i class='bx bx-collection'></i> إدارة المجموعات
          </button>
        </div>
      </div>

      <%
        const days = [
          { key: 'saturday', label: 'السبت' },
          { key: 'sunday', label: 'الأحد' },
          { key: 'monday', label: 'الإثنين' },
          { key: 'tuesday', label: 'الثلاثاء' },
          { key: 'wednesday', label: 'الأربعاء' },
          { key: 'thursday', label: 'الخميس' },
          { key: 'friday', label: 'الجمعة' }
        ];

        // Organize schedule by day
        const scheduleByDay = {};
        days.forEach(d => scheduleByDay[d.key] = []);

        groups.forEach(group => {
          if (group.weeklySchedule) {
            group.weeklySchedule.forEach(s => {
              if (scheduleByDay[s.day]) {
                scheduleByDay[s.day].push({ ...s, groupName: group.name, groupId: group.id, type: group.type });
              }
            });
          }
        });

        // Time slots (from 8 AM to 11 PM)
        const timeSlots = [];
        for(let i=8; i<=22; i++) {
          timeSlots.push({ hour: i, label: `${i > 12 ? i-12 : i}:00 ${i >= 12 ? 'م' : 'ص'}` });
        }
      %>

      <div class="calendar-container">
        <div class="calendar-grid">
          <!-- Headers -->
          <div class="grid-header" style="background: #f1f1f1;">الوقت</div>
          <% days.forEach(day => { %>
            <div class="grid-header"><%= day.label %></div>
          <% }) %>

          <!-- Time Rows -->
          <% timeSlots.forEach(slot => { %>
            <div class="time-col"><%= slot.label %></div>
            <% days.forEach(day => { %>
              <div class="day-cell">
                <% 
                  const events = scheduleByDay[day.key].filter(e => {
                    const startHour = parseInt(e.startTime.split(':')[0]);
                    return startHour === slot.hour;
                  });
                %>
                <% events.forEach(event => { %>
                  <div class="event-card" style="<%= event.type === 'private' ? 'background:#fff3e0; border-right-color:#ff9800;' : '' %>" onclick="location.href='/center/groups/<%= event.groupId %>'">
                    <div class="event-time" style="<%= event.type === 'private' ? 'color:#e65100;' : '' %>"><%= event.startTime %> — <%= event.endTime %></div>
                    <div class="event-name"><%= event.groupName %></div>
                    <div class="event-type">
                      <i class='bx bx-<%= event.type === "private" ? "lock-alt" : "globe" %>'></i>
                      <%= event.type === 'private' ? 'مجموعة خاصة' : 'مجموعة عامة' %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% }) %>
          <% }) %>
        </div>
      </div>

      <div class="legend">
        <div class="legend-item"><div class="dot" style="background: var(--primary);"></div> مجموعة عامة</div>
        <div class="legend-item"><div class="dot" style="background: #ff9800;"></div> مجموعة خاصة</div>
      </div>
    
  <%- include('../partials/footer') %>
    </main>
  </div>

  <!-- Manage Schedule Modal -->
  <div class="modal-overlay" id="scheduleModal">
    <div class="modal-card">
      <div class="modal-header">
        <h2><i class='bx bx-calendar-edit'></i> إضافة وتعديل مواعيد المجموعات</h2>
        <button class="close-btn" onclick="closeScheduleModal()">&times;</button>
      </div>
      <form id="scheduleForm" onsubmit="handleSaveSchedule(event)">
        <div class="modal-body">
          <div class="form-group">
            <label>اختر المجموعة الدراسية *</label>
            <select id="scheduleGroupSelect" onchange="onGroupSelectChange()" required>
              <option value="">-- اختر مجموعة لتحميل مواعيدها --</option>
              <% groups.forEach(g => { %>
                <option value="<%= g.id %>"><%= g.name %></option>
              <% }) %>
            </select>
          </div>

          <div id="scheduleBuilderSection" style="display: none; margin-top: 1.5rem;">
            <div style="font-weight: 800; font-size: 0.9rem; color: #555; margin-bottom: 0.75rem; border-bottom: 2px solid #f0f0f0; padding-bottom: 0.5rem; text-align: right;">
              جدول المواعيد الأسبوعية للمجموعة:
            </div>
            
            <div id="modalScheduleRows">
              <!-- Dynamically populated rows -->
            </div>
            
            <button type="button" class="btn-add-row" onclick="addModalScheduleRow()">
              <i class='bx bx-plus'></i> إضافة موعد جديد
            </button>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-cancel" onclick="closeScheduleModal()">إلغاء</button>
          <button type="submit" id="saveScheduleBtn" class="btn-save" style="display: none;"><i class='bx bx-check'></i> حفظ المواعيد</button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    const DAYS = [
      { val: 'saturday',  label: 'السبت' },
      { val: 'sunday',    label: 'الأحد' },
      { val: 'monday',    label: 'الإثنين' },
      { val: 'tuesday',   label: 'الثلاثاء' },
      { val: 'wednesday', label: 'الأربعاء' },
      { val: 'thursday',  label: 'الخميس' },
      { val: 'friday',    label: 'الجمعة' },
    ];

    function openScheduleModal() {
      document.getElementById('scheduleModal').style.display = 'flex';
      document.getElementById('scheduleGroupSelect').value = '';
      document.getElementById('scheduleBuilderSection').style.display = 'none';
      document.getElementById('saveScheduleBtn').style.display = 'none';
      document.getElementById('modalScheduleRows').innerHTML = '';
    }

    function closeScheduleModal() {
      document.getElementById('scheduleModal').style.display = 'none';
    }

    async function onGroupSelectChange() {
      const groupId = document.getElementById('scheduleGroupSelect').value;
      const builderSection = document.getElementById('scheduleBuilderSection');
      const saveBtn = document.getElementById('saveScheduleBtn');
      const container = document.getElementById('modalScheduleRows');
      
      container.innerHTML = '';

      if (!groupId) {
        builderSection.style.display = 'none';
        saveBtn.style.display = 'none';
        return;
      }

      Swal.fire({
        title: 'جاري تحميل مواعيد المجموعة...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
      });

      try {
        const res = await fetch(`/api/v1/groups/${groupId}`);
        const result = await res.json();
        
        Swal.close();

        if (result.success) {
          builderSection.style.display = 'block';
          saveBtn.style.display = 'block';
          
          const group = result.data;
          if (group.weeklySchedule && group.weeklySchedule.length > 0) {
            group.weeklySchedule.forEach(s => {
              addModalScheduleRow(s.day, s.startTime, s.endTime);
            });
          } else {
            addModalScheduleRow();
          }
        } else {
          Swal.fire('خطأ!', result.message || 'فشل تحميل بيانات المجموعة', 'error');
        }
      } catch (err) {
        Swal.close();
        Swal.fire('خطأ!', 'حدث خطأ فني أثناء تحميل البيانات', 'error');
      }
    }

    function addModalScheduleRow(day = 'saturday', startTime = '08:00', endTime = '09:00') {
      const container = document.getElementById('modalScheduleRows');
      const div = document.createElement('div');
      div.className = 'schedule-row';
      const dayOptions = DAYS.map(d => `<option value="${d.val}" ${d.val === day ? 'selected' : ''}>${d.label}</option>`).join('');
      
      div.innerHTML = `
        <select class="sched-day">${dayOptions}</select>
        <input type="time" class="sched-start" value="${startTime}">
        <input type="time" class="sched-end" value="${endTime}">
        <button type="button" class="btn-remove-row" onclick="this.parentElement.remove()"><i class='bx bx-x'></i></button>
      `;
      container.appendChild(div);
    }

    async function handleSaveSchedule(e) {
      e.preventDefault();
      
      const groupId = document.getElementById('scheduleGroupSelect').value;
      if (!groupId) return;

      const rows = document.querySelectorAll('#modalScheduleRows .schedule-row');
      const weeklySchedule = Array.from(rows).map(row => ({
        day: row.querySelector('.sched-day').value,
        startTime: row.querySelector('.sched-start').value,
        endTime: row.querySelector('.sched-end').value,
      }));

      Swal.fire({
        title: 'جاري حفظ التعديلات...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
      });

      try {
        const updateData = {
          weeklySchedule
        };

        const res = await fetch(`/api/v1/groups/${groupId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updateData),
        });

        const r = await res.json();
        
        Swal.close();

        if (res.ok && r.success) {
          await Swal.fire({
            title: 'تم الحفظ!',
            text: 'تم تحديث مواعيد المجموعة بنجاح.',
            icon: 'success',
            timer: 1500,
            showConfirmButton: false
          });
          location.reload();
        } else {
          Swal.fire('خطأ!', r.message || 'فشل حفظ المواعيد', 'error');
        }
      } catch (err) {
        Swal.close();
        Swal.fire('خطأ!', 'حدث خطأ فني أثناء الاتصال بالسيرفر', 'error');
      }
    }
  </script>

</body>
</html>
