<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    :root {
      --primary: #4aa3df;
      --primary-dark: #2980b9;
      --bg: #f8f9fa;
      --card-bg: #ffffff;
      --text: #2d3436;
      --text-muted: #636e72;
      --border: #dfe6e9;
    }
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Cairo',sans-serif; background:var(--bg); display:flex; min-height:100vh; color:var(--text); }
    
    .wrapper { flex:1; display:flex; flex-direction:column; min-width:0; }
    
    .topbar {
      height:65px; background:linear-gradient(135deg,#2980b9,var(--primary));
      display:flex; align-items:center; padding:0 2rem; color:#fff;
      font-size:1.1rem; font-weight:700; gap:1rem; flex-shrink:0;
    }
    
    .main { padding: 2.5rem; flex: 1; overflow-y: auto; }
    
    .page-title {
      font-size: 1.5rem; font-weight: 800; margin-bottom: 2rem;
      display: flex; align-items: center; gap: 10px; color: var(--text);
    }
    
    .settings-container {
      max-width: 800px;
      margin: 0 auto;
    }
    
    .card {
      background: var(--card-bg); border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0,0,0,.04); padding: 2.5rem;
    }
    
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .form-group.full { grid-column: 1 / -1; }
    
    label { font-size: 0.9rem; font-weight: 700; color: var(--text-muted); }
    
    .form-control {
      border: 2px solid var(--border); border-radius: 12px; padding: 0.8rem 1.2rem;
      font-family: inherit; font-size: 0.95rem; outline: none; transition: 0.2s;
      background: #fafbfc;
    }
    .form-control:focus { border-color: var(--primary); background: #fff; box-shadow: 0 0 0 3px rgba(74,163,223,.1); }
    
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
      padding: 0.9rem 2rem; border-radius: 12px; font-family: inherit;
      font-weight: 700; font-size: 1rem; cursor: pointer; border: none; transition: 0.2s;
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: #fff; box-shadow: 0 8px 16px rgba(74,163,223,.3);
      width: 100%; margin-top: 2rem;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 20px rgba(74,163,223,.4); }
    .btn-primary:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }
    
    .center-logo-preview {
      width: 100px; height: 100px; border-radius: 50%;
      background: var(--primary); color: white; display: flex;
      align-items: center; justify-content: center; font-size: 2.5rem; font-weight: 800;
      margin: 0 auto 2rem; box-shadow: 0 8px 24px rgba(74,163,223,.3);
    }
  </style>
</head>
<body>

  <%- include('../partials/center-sidebar', { active: 'settings' }) %>

  <div class="wrapper">
    <header class="topbar">
      <i class='bx bx-cog' style="font-size:1.4rem;"></i>
      <span>إعدادات السنتر</span>
    </header>

    <main class="main">
      <div class="settings-container">
        <h2 class="page-title"><i class='bx bx-sliders-alt'></i> إدارة معلومات السنتر</h2>
        
        <div class="card">
          <div class="center-logo-preview">
            <%= centerInfo.name.charAt(0) %>
          </div>
          
          <form id="settingsForm" onsubmit="saveSettings(event)">
            <div class="form-grid">
              <div class="form-group full">
                <label>اسم السنتر / المركز</label>
                <input type="text" id="name" class="form-control" value="<%= centerInfo.name %>" required>
              </div>
              
              <div class="form-group">
                <label>رقم الهاتف للتواصل</label>
                <input type="text" id="phone" class="form-control" value="<%= centerInfo.phone || '' %>" placeholder="مثال: 01012345678">
              </div>

              <div class="form-group">
                <label>البريد الإلكتروني (اختياري)</label>
                <input type="email" id="email" class="form-control" value="<%= centerInfo.email || '' %>" placeholder="contact@center.com">
              </div>

              <div class="form-group full">
                <label>العنوان بالتفصيل</label>
                <input type="text" id="address" class="form-control" value="<%= centerInfo.address || '' %>" placeholder="اسم الشارع، الحي، المدينة">
              </div>
            </div>
            
            <button type="submit" class="btn btn-primary" id="saveBtn">
              <i class='bx bx-save'></i> حفظ التعديلات
            </button>
          </form>
        </div>
      </div>
    
  <%- include('../partials/footer') %>
    </main>
  </div>

  <script>
    async function saveSettings(e) {
      e.preventDefault();
      const btn = document.getElementById('saveBtn');
      btn.disabled = true;
      btn.innerHTML = `<i class='bx bx-loader-alt bx-spin'></i> جاري الحفظ...`;
      
      const payload = {
        name: document.getElementById('name').value,
        phone: document.getElementById('phone').value,
        email: document.getElementById('email').value,
        address: document.getElementById('address').value,
      };
      
      try {
        const res = await fetch('/api/v1/centers/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        
        const data = await res.json();
        
        if (res.ok && data.success) {
          Swal.fire({
            title: 'تم الحفظ!',
            text: data.message || 'تم تحديث الإعدادات بنجاح',
            icon: 'success',
            timer: 2000,
            showConfirmButton: false
          }).then(() => {
            location.reload();
          });
        } else {
          Swal.fire({
            title: 'حدث خطأ!',
            text: data.message || 'فشل تحديث الإعدادات',
            icon: 'error',
            confirmButtonText: 'حسناً'
          });
        }
      } catch (err) {
        Swal.fire({
          title: 'خطأ بالشبكة',
          text: 'يرجى التحقق من اتصالك بالإنترنت والمحاولة مجدداً',
          icon: 'error',
          confirmButtonText: 'حسناً'
        });
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<i class='bx bx-save'></i> حفظ التعديلات`;
      }
    }
  </script>

</body>
</html>
