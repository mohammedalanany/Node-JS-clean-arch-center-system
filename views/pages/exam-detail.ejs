<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    :root {
      --primary: #4aa3df; --success: #2ecc71; --danger: #e74c3c;
      --bg-body: #f4f7f6; --text-main: #333; --text-muted: #777;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Cairo', sans-serif; background: var(--bg-body); color: var(--text-main); display: flex; min-height: 100vh; }
    
    .wrapper { flex: 1; padding: 2rem; max-width: 1200px; margin: 0 auto; }
    
    /* Header Card */
    .header-card { background: white; border-radius: 16px; padding: 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06); margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; }
    .exam-info h1 { font-size: 1.6rem; font-weight: 800; margin-bottom: 0.5rem; }
    .exam-info p { color: var(--text-muted); font-weight: 600; display: flex; align-items: center; gap: 10px; }
    
    .stats-row { display: flex; gap: 2rem; }
    .stat-box { text-align: center; }
    .stat-val { font-size: 1.8rem; font-weight: 800; color: var(--primary); }
    .stat-lbl { font-size: 0.8rem; font-weight: 700; color: var(--text-muted); }

    /* Grading Table */
    .grading-card { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); overflow: hidden; }
    .table-header { padding: 1.5rem; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; }
    .table-header h2 { font-size: 1.1rem; font-weight: 800; }
    
    .grading-table { width: 100%; border-collapse: collapse; }
    .grading-table th, .grading-table td { padding: 1rem 1.5rem; text-align: right; border-bottom: 1px solid #f9f9f9; }
    .grading-table th { background: #fafafa; font-size: 0.85rem; color: var(--text-muted); font-weight: 800; }
    .grading-table tr:hover { background: #fcfdfe; }
    
    .student-cell { display: flex; align-items: center; gap: 12px; }
    .student-avatar { width: 36px; height: 36px; border-radius: 50%; background: #eee; }
    
    .mark-input { width: 80px; padding: 0.5rem; border: 2px solid #edf2f7; border-radius: 8px; font-family: inherit; font-weight: 700; text-align: center; transition: 0.2s; }
    .mark-input:focus { border-color: var(--primary); outline: none; background: #f0f7ff; }
    .mark-input.pass { color: var(--success); border-color: rgba(46, 204, 113, 0.2); }
    .mark-input.fail { color: var(--danger); border-color: rgba(231, 76, 60, 0.2); }

    .btn-save { background: var(--primary); color: white; border: none; padding: 0.8rem 2rem; border-radius: 10px; font-weight: 800; cursor: pointer; display: flex; align-items: center; gap: 10px; font-family: inherit; transition: 0.2s; }
    .btn-save:hover { background: #358cc5; transform: translateY(-2px); box-shadow: 0 4px 15px rgba(74, 163, 223, 0.3); }

    .sticky-footer { position: sticky; bottom: 2rem; background: white; margin-top: 2rem; padding: 1.25rem 2rem; border-radius: 16px; box-shadow: 0 -10px 30px rgba(0,0,0,0.05); display: flex; justify-content: space-between; align-items: center; border: 1px solid #eee; }
  </style>
</head>
<body>

  <%- include('../partials/center-sidebar', { active: 'exams' }) %>

  <div class="wrapper">
    <div style="margin-bottom: 1rem;">
      <a href="/center/exams" style="text-decoration: none; color: var(--text-muted); font-weight: 700; display: flex; align-items: center; gap: 4px;">
        <i class='bx bx-right-arrow-alt'></i> العودة لقائمة الامتحانات
      </a>
    </div>

    <div class="header-card">
      <div class="exam-info">
        <h1><%= exam.title %></h1>
        <p>
          <span><i class='bx bx-calendar'></i> <%= new Date(exam.date).toLocaleDateString('ar-EG') %></span>
          <span><i class='bx bx-group'></i> <%= exam.group ? exam.group.name : 'كافة الطلاب' %></span>
          <span><i class='bx bx-check-double'></i> الدرجة النهائية: <%= Number(exam.totalMarks) %></span>
        </p>
      </div>
      <div class="stats-row">
        <div class="stat-box">
          <div class="stat-val"><%= stats.count %></div>
          <div class="stat-lbl">طالب مرصود</div>
        </div>
        <div class="stat-box">
          <div class="stat-val"><%= stats.average %></div>
          <div class="stat-lbl">متوسط الدرجات</div>
        </div>
        <div class="stat-box">
          <div class="stat-val"><%= stats.passCount %></div>
          <div class="stat-lbl">ناجحين</div>
        </div>
      </div>
    </div>

    <div class="grading-card">
      <div class="table-header">
        <h2><i class='bx bx-table'></i> كشف رصد الدرجات</h2>
        <div style="font-size: 0.85rem; color: var(--text-muted);">أدخل الدرجات لكل طالب ثم اضغط حفظ النتائج في النهاية</div>
      </div>
      
      <table class="grading-table">
        <thead>
          <tr>
            <th>اسم الطالب</th>
            <th>كود الطالب</th>
            <th>الدرجة المرصودة</th>
            <th>ملاحظات</th>
          </tr>
        </thead>
        <tbody id="gradingBody">
          <% 
            const existingResults = {};
            exam.results.forEach(r => existingResults[r.studentId] = r);
          %>
          <% students.forEach(student => { %>
            <% const result = existingResults[student.id]; %>
            <tr data-student-id="<%= student.id %>">
              <td>
                <div class="student-cell">
                  <div class="student-avatar" style="display: flex; align-items: center; justify-content: center; font-weight: 800; color: #aaa;">
                    <%= student.firstName[0] %>
                  </div>
                  <div style="font-weight: 700;"><%= student.firstName %> <%= student.lastName %></div>
                </div>
              </td>
              <td style="font-family: monospace; color: var(--text-muted);"><%= student.barcode || student.id %></td>
              <td>
                <input type="number" 
                       class="mark-input <%= result ? (result.attainedMarks >= exam.totalMarks/2 ? 'pass' : 'fail') : '' %>" 
                       step="0.5" 
                       max="<%= exam.totalMarks %>" 
                       min="0" 
                       value="<%= result ? result.attainedMarks : '' %>"
                       placeholder="0.0"
                       oninput="validateInput(this)"
                >
                <span style="font-size: 0.8rem; color: #ccc;">/ <%= Number(exam.totalMarks) %></span>
              </td>
              <td>
                <input type="text" class="form-control" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;" placeholder="ملاحظات (غائب، ممتاز...)" value="<%= result ? result.notes : '' %>">
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="sticky-footer">
      <div style="color: var(--text-muted); font-size: 0.9rem;">
        <i class='bx bx-info-circle'></i> سيتم إرسال إشعار للطلاب/أولياء الأمور بالنتيجة فور الحفظ (اختياري)
      </div>
      <button class="btn-save" onclick="saveResults()">
        <i class='bx bx-cloud-upload'></i> حفظ كافة النتائج
      </button>
    </div>
  </div>

  <script>
    const TOTAL_MARKS = <%= Number(exam.totalMarks) %>;

    function validateInput(input) {
      const val = parseFloat(input.value);
      if (val > TOTAL_MARKS) {
        input.value = TOTAL_MARKS;
      }
      if (val < 0) input.value = 0;

      // Visual feedback
      input.classList.remove('pass', 'fail');
      if (val >= TOTAL_MARKS / 2) input.classList.add('pass');
      else if (!isNaN(val)) input.classList.add('fail');
    }

    async function saveResults() {
      const rows = document.querySelectorAll('#gradingBody tr');
      const results = [];
      
      rows.forEach(row => {
        const studentId = row.dataset.studentId;
        const markInput = row.querySelector('.mark-input');
        const notesInput = row.querySelector('input[type="text"]');
        
        if (markInput.value !== '') {
          results.push({
            studentId: Number(studentId),
            attainedMarks: parseFloat(markInput.value),
            notes: notesInput.value || undefined
          });
        }
      });

      if (results.length === 0) {
        return Swal.fire('تنبيه', 'لم يتم إدخال أي درجات لرصدها', 'warning');
      }

      try {
        Swal.fire({ title: 'جاري الحفظ...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

        const res = await fetch(`/api/v1/exams/<%= exam.id %>/results`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ results })
        });

        if (res.ok) {
          Swal.fire({ title: 'تم الحفظ!', text: 'تم رصد درجات الطلاب بنجاح', icon: 'success' });
          setTimeout(() => location.reload(), 1500);
        } else {
          const err = await res.json();
          Swal.fire('خطأ', err.message, 'error');
        }
      } catch (err) {
        Swal.fire('خطأ', 'حدث خطأ فني أثناء الحفظ', 'error');
      }
    }
  </script>

</body>
</html>
